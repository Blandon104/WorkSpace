<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RECORDATE - PPI</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

  <!--
    PPI: RECORDATE - Sistema Recordatorio de Actividades Académicas
    Requisitos implementados en esta etapa:
    - Primero iniciar sesión.
    - El menú aparece después de iniciar sesión.
    - Las opciones del menú cambian según el rol.
    - Todos los módulos que todavía no están desarrollados muestran "En construcción".
    - La autenticación real con Supabase queda preparada para integrarse posteriormente.
  -->

  <nav id="navbar" class="navbar navbar-expand-lg bg-body-tertiary d-none">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">RECORDATE</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="menuPrincipal">
        <ul id="menu" class="navbar-nav me-auto mb-2 mb-lg-0"></ul>
        <span id="usuarioActual" class="navbar-text me-3"></span>
        <button id="btnCerrarSesion" class="btn btn-outline-danger">Cerrar sesión</button>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <!-- Inicio de sesión: es la primera pantalla que ve el usuario -->
    <section id="loginSection" class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
          <div class="card-body">
            <h1 class="h3 text-center mb-4">Iniciar sesión</h1>

            <form id="loginForm">
              <div class="mb-3">
                <label for="email" class="form-label">Correo electrónico</label>
                <input type="email" class="form-control" id="email" required>
              </div>

              <div class="mb-3">
                <label for="password" class="form-label">Contraseña</label>
                <input type="password" class="form-control" id="password" required>
              </div>

              <div class="mb-3">
                <label for="rol" class="form-label">Rol de prueba</label>
                <select id="rol" class="form-select" required>
                  <option value="estudiante">Estudiante</option>
                  <option value="trabajador">Trabajador</option>
                  <option value="administrador">Administrador</option>
                </select>
              </div>

              <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
              <p id="mensajeLogin" class="text-danger mt-3 mb-0"></p>
            </form>

            <p class="text-muted small mt-3 mb-0">
              La autenticación real se conectará posteriormente con Supabase.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contenido protegido: solo aparece después del login -->
    <section id="appSection" class="d-none">
      <div class="text-center mb-5">
        <h1>Bienvenido a RECORDATE</h1>
        <p class="lead">Sistema de recordatorio de actividades académicas.</p>
        <span id="rolActual" class="badge text-bg-primary"></span>
      </div>

      <div class="row g-4">
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h2 class="h5">Actividades</h2>
              <p>Gestión de tareas, fechas y prioridades.</p>
              <span class="badge text-bg-warning">En construcción</span>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h2 class="h5">Recordatorios</h2>
              <p>Configuración de alarmas y notificaciones.</p>
              <span class="badge text-bg-warning">En construcción</span>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h2 class="h5">Perfil</h2>
              <p>Información y configuración del usuario.</p>
              <span class="badge text-bg-warning">En construcción</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="text-center py-4 border-top mt-5">
    <p class="mb-0">RECORDATE - PPI</p>
  </footer>

  <script>
    /*
      Menú por rol.
      Esta versión utiliza roles de prueba para desarrollar la interfaz.
      En la versión final, el rol debe obtenerse desde Supabase después de
      autenticar al usuario.
    */
    const menusPorRol = {
      estudiante: [
        { texto: 'Inicio', seccion: 'appSection' },
        { texto: 'Mis actividades', seccion: 'appSection' },
        { texto: 'Recordatorios', seccion: 'appSection' },
        { texto: 'Mi perfil', seccion: 'appSection' }
      ],
      trabajador: [
        { texto: 'Inicio', seccion: 'appSection' },
        { texto: 'Actividades', seccion: 'appSection' },
        { texto: 'Recordatorios', seccion: 'appSection' },
        { texto: 'Mi perfil', seccion: 'appSection' }
      ],
      administrador: [
        { texto: 'Inicio', seccion: 'appSection' },
        { texto: 'Usuarios', seccion: 'appSection' },
        { texto: 'Actividades', seccion: 'appSection' },
        { texto: 'Administración', seccion: 'appSection' }
      ]
    };

    const loginSection = document.getElementById('loginSection');
    const appSection = document.getElementById('appSection');
    const navbar = document.getElementById('navbar');
    const menu = document.getElementById('menu');
    const usuarioActual = document.getElementById('usuarioActual');
    const rolActual = document.getElementById('rolActual');
    const loginForm = document.getElementById('loginForm');
    const mensajeLogin = document.getElementById('mensajeLogin');
    const btnCerrarSesion = document.getElementById('btnCerrarSesion');

    function mostrarMenu(rol) {
      menu.innerHTML = '';

      menusPorRol[rol].forEach(item => {
        const li = document.createElement('li');
        li.className = 'nav-item';

        const a = document.createElement('a');
        a.className = 'nav-link';
        a.href = '#appSection';
        a.textContent = item.texto;

        li.appendChild(a);
        menu.appendChild(li);
      });
    }

    function iniciarSesion(email, rol) {
      loginSection.classList.add('d-none');
      appSection.classList.remove('d-none');
      navbar.classList.remove('d-none');

      usuarioActual.textContent = email;
      rolActual.textContent = `Rol: ${rol}`;
      mostrarMenu(rol);

      sessionStorage.setItem('recordateSesion', JSON.stringify({ email, rol }));
    }

    function cerrarSesion() {
      sessionStorage.removeItem('recordateSesion');
      appSection.classList.add('d-none');
      navbar.classList.add('d-none');
      loginSection.classList.remove('d-none');
      loginForm.reset();
      menu.innerHTML = '';
    }

    loginForm.addEventListener('submit', event => {
      event.preventDefault();

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const rol = document.getElementById('rol').value;

      if (!email || !password) {
        mensajeLogin.textContent = 'Debes ingresar correo y contraseña.';
        return;
      }

      mensajeLogin.textContent = '';
      iniciarSesion(email, rol);
    });

    btnCerrarSesion.addEventListener('click', cerrarSesion);

    // Recuperar sesión mientras se desarrolla el proyecto.
    const sesionGuardada = sessionStorage.getItem('recordateSesion');
    if (sesionGuardada) {
      const sesion = JSON.parse(sesionGuardada);
      iniciarSesion(sesion.email, sesion.rol);
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
